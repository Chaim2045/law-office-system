# Shared-code mechanism (PR-SHARE-1) — pin LF so the content-hash cache-bust
# token computed by shared-web/emit.js is OS-deterministic. Without this, a
# Windows working tree (core.autocrlf=true) would check these out as CRLF, whose
# hash differs from the LF bytes git/CI(Linux)/Netlify store and serve — breaking
# the drift-guard's token==content-hash invariant. Scoped to these paths only
# (no repo-wide rule) to avoid churning the rest of the repo's line endings.
shared-web/** text eol=lf
apps/admin-panel/js/modules/idle-timeout-manager.js text eol=lf
apps/user-app/js/modules/idle-timeout-manager.js text eol=lf
# PR-SHARE-2 — W1 trivial pairs (2-6): pin the emitted copies to LF so the
# content-hash token is OS-deterministic (same reason as idle-timeout above).
apps/admin-panel/js/modules/work-hours-calculator.js text eol=lf
apps/user-app/js/modules/work-hours-calculator.js text eol=lf
apps/admin-panel/js/shared/business-rules-adapter.js text eol=lf
apps/user-app/js/shared/business-rules-adapter.js text eol=lf
apps/admin-panel/js/shared/holidays-cache.js text eol=lf
apps/user-app/js/shared/holidays-cache.js text eol=lf
apps/admin-panel/js/shared/work-hours-constants.js text eol=lf
apps/user-app/js/shared/work-hours-constants.js text eol=lf
apps/admin-panel/js/core/system-constants.js text eol=lf
apps/user-app/js/core/system-constants.js text eol=lf
# PR-SHARE-3 — W2 parameterized pair (config-loader): pin the emitted copies to
# LF so the per-target content-hash tokens are OS-deterministic. (admin and user
# copies differ by the injected APP_CONTEXT literal → different tokens by design.)
apps/admin-panel/js/core/config-loader.js text eol=lf
apps/user-app/js/core/config-loader.js text eol=lf
